# Copy to .env. Every variable is documented in docs/CONFIGURATION.md (generated).
ENV=dev
DATABASE_URL=sqlite:///./data/intelligence.db
MODEL_DIR=./data/models

# Secrets: REQUIRED when ENV=production. Generate KEK with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEK=
ADMIN_API_KEY=
JWT_SECRET=
METRICS_TOKEN=

# Dev only: allow sources on localhost / private networks (SSRF guard off)
ALLOW_PRIVATE_SOURCES=false

# Background worker and scheduler
WORKER_ENABLED=true
SYNC_INTERVAL_S=0

# LLM layer (optional: without a key the deterministic template narrator is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
