{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelligence:contract:lead",
  "title": "lead",
  "description": "GET /export/leads NDJSON line (additionalProperties intentionally open: unknown fields must be ignored by consumers)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "funnel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_key": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_campaign": {
      "type": [
        "string",
        "null"
      ]
    },
    "converted_to_order": {
      "type": "boolean"
    },
    "order_total": {
      "type": [
        "number",
        "null"
      ]
    },
    "first_order_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "created_at",
    "contact_key",
    "converted_to_order"
  ]
}
