{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelligence:contract:funnel_structure",
  "title": "funnel_structure",
  "description": "GET /export/funnel-structure record. The contract leaves the exact shape open; the real Funnels app answers {data:[...], next_cursor} with the funnel as `id` and each step as `step_id`, without a step `type` (blocks are counted instead). Accepted: `funnel_id` or `id` for the funnel, `step_id` or `id` for a step (additionalProperties intentionally open: unknown fields must be ignored by consumers)",
  "type": "object",
  "properties": {
    "funnel_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "blocks": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "word_count": {
            "type": "integer"
          },
          "has_order_bump": {
            "type": "boolean"
          },
          "has_upsell": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "order",
          "word_count"
        ],
        "anyOf": [
          {
            "required": [
              "step_id"
            ]
          },
          {
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "steps"
  ],
  "anyOf": [
    {
      "required": [
        "funnel_id"
      ]
    },
    {
      "required": [
        "id"
      ]
    }
  ]
}
